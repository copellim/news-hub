# Le variabili vivono nel progetto Vercel: in locale si scaricano con
#   vercel env pull .env.local --environment development
# che riscrive il file per intero. Aggiungerle a mano qui significa perderle al
# pull successivo, e il pull va rifatto spesso perché VERCEL_OIDC_TOKEN scade.

# Reddit: registra un'app "script" su https://www.reddit.com/prefs/apps
# (redirect uri: http://localhost:3000 — non viene usata dal flusso client_credentials).
# Senza queste variabili la corsia r/programming resta vuota, il resto funziona.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Vercel Blob (store privato news-hub-blob): riassunti e stato degli utenti.
# Le inietta Vercel collegando lo store al progetto, ambiente Development compreso.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Riassunti dei paper con Claude Haiku. Senza chiave i riassunti già salvati si
# vedono comunque, ma non se ne generano di nuovi.
ANTHROPIC_API_KEY=

# Login Google (Better Auth, senza database). Client OAuth "Web application" con
# redirect URI http://localhost:3000/api/auth/callback/google e lo stesso
# percorso sul dominio di produzione.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Almeno 32 caratteri: openssl rand -base64 32. Cambiarlo chiude tutte le sessioni.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Email ammesse al login, separate da virgola.
ALLOWED_EMAILS=
