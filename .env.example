# The variables live in the Vercel project: locally they are downloaded with
#   vercel env pull .env.local --environment development
# which rewrites the whole file. Adding them here by hand means losing them at
# the next pull, and the pull must be redone often because VERCEL_OIDC_TOKEN expires.

# Reddit: register a "script" app at https://www.reddit.com/prefs/apps
# (redirect uri: http://localhost:3000 — it is not used by the client_credentials flow).
# Without these variables the r/programming lane stays empty, the rest works.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Vercel Blob (private store news-hub-blob): summaries and user state.
# Vercel injects them when the store is linked to the project, Development environment included.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Paper summaries with Claude Haiku. Without a key the summaries already saved
# are still shown, but no new ones are generated.
ANTHROPIC_API_KEY=

# Google sign-in (Better Auth, no database). OAuth client "Web application" with
# redirect URI http://localhost:3000/api/auth/callback/google and the same
# path on the production domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 characters: openssl rand -base64 32. Changing it closes all sessions.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Emails allowed to sign in, comma-separated.
ALLOWED_EMAILS=

# Scientific screening: optional keys to increase the reliability and quotas
# of the bibliographic APIs. Without them, public access is used and any
# limits/errors are shown as unverifiable data. The PDF analysis uses ANTHROPIC_API_KEY.
# https://openalex.org/settings/api
OPENALEX_API_KEY=
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Affinity of papers with favourites (Jev). Without a key the normal ranking remains.
# https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
